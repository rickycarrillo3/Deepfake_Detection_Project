# Data (uploaded incrementally, large binaries)
/data/**
!/data/.gitkeep
!/data/README.md

# Results (regenerated per run; keep only the folder structure + docs)
/results/**
!/results/**/
!/results/.gitkeep
!/results/README.md
!/results/**/.gitkeep

# Model weights
*.pth
*.pt
*.onnx
*.h5
*.ckpt
*.safetensors

# RINE resolves its checkpoint from "ckpt/" relative to the CWD, and run.py runs
# from the repo root, so models/rine/setup.sh drops a symlink to the vendored
# checkpoints here. Anchored, so it does not hide a real ckpt/ inside a model dir.
/ckpt

# Per-model isolated environments
models/*/venv/
models/*/.venv/
models/*/env/

# Trained-ensemble environments (gradient_boosting/setup.sh, neural_network/setup.sh).
# Their fitted output lands in results/gradient_boosting/ and results/neural_network/,
# already covered by the /results/** rule above; the *.pt rule also catches the MLP
# checkpoint wherever it ends up.
gradient_boosting/venv/
gradient_boosting/.venv/
gradient_boosting/env/
neural_network/venv/
neural_network/.venv/
neural_network/env/

# Vendored clones of each model's upstream GitHub repo
models/co-spy/CO-SPY/
models/grag2021/GANimageDetection/
models/freqnet/FreqNet-DeepfakeDetection/

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Claude
.claude/
